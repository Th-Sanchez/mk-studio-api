PORT=8080
# Em producao (Render), defina SPRING_PROFILES_ACTIVE=prod para falhar caso alguma variavel obrigatoria falte
# SPRING_PROFILES_ACTIVE=prod

# Local (Docker Compose):
DB_URL=jdbc:postgresql://localhost:5432/mk_studio
DB_USERNAME=mk_studio
DB_PASSWORD=mk_studio_dev_password

# Producao (Supabase + Render Free Tier — use SEMPRE o Session Pooler IPv4, porta 5432, com sslmode=require):
# DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<seu-project-ref>
# DB_PASSWORD=<senha-do-banco-supabase>

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_SECRET=troque-por-uma-chave-secreta-forte-com-no-minimo-32-caracteres
JWT_EXPIRATION_SECONDS=86400

APP_ADMIN_NAME=Personal MK Studio
APP_ADMIN_EMAIL=personal@mkstudio.com
APP_ADMIN_PASSWORD=troque-essa-senha-em-producao
